# Copy this file to .env and enter the settings for your own computer.
# Never upload or commit your personal .env file.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=maa_bhagwati_store
PORT=3000

# Replace both values below before starting the server.
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_PASSWORD=change_me

# ADMIN_SESSION_SECRET must be at least 32 characters.
# Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=generate_a_new_random_secret
