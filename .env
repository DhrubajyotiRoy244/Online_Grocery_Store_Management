DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD="your_db_password"
ADMIN_PASSWORD="choose_a_unique_password_at_least_12_chars"
ADMIN_SESSION_SECRET="put_a_random_secret_of_at_least_32_chars_here"
PORT=3000

# Admin dashboard (http://localhost:3000/admin/index.html).
# The server will not start until both values below are replaced with your own:
#   ADMIN_PASSWORD        at least 12 characters
#   ADMIN_SESSION_SECRET  at least 32 characters (generate one with: openssl rand -hex 32)
